{
    "name": "joplin-plugin-markdown-formatter",
    "version": "1.6.12",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint src/ && npm run lint:dead-code && npm run lint:complexity",
        "lint:dead-code": "fallow dead-code",
        "lint:complexity": "fallow health --complexity",
        "lint:fix": "oxlint src/ --fix",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.5.0",
        "@types/mdast": "^4.0.4",
        "@types/node": "^24.19.2",
        "@types/unist": "^3.0.3",
        "eslint-plugin-regexp": "^3.3.3",
        "fallow": "^3.43.0",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2007",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "diff-match-patch-es": "^2.0.1",
        "mdast-util-from-markdown": "^2.1.0",
        "mdast-util-frontmatter": "^2.0.1",
        "mdast-util-gfm": "^3.1.0",
        "mdast-util-math": "^3.0.0",
        "micromark-extension-frontmatter": "^2.0.0",
        "micromark-extension-gfm": "^3.0.0",
        "micromark-extension-gfm-table": "^2.1.1",
        "micromark-extension-math": "^3.1.0"
    }
}
