{
    "name": "joplin-plugin-markdown-formatter",
    "version": "1.6.12",
    "scripts": {
        "dist": "npm run typecheck && node scripts/build.mjs",
        "prepare": "npm run dist",
        "updateVersion": "node scripts/updateVersion.mjs",
        "updateApi": "node scripts/updateApi.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/ scripts/",
        "lint:fix": "eslint src/ scripts/ --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run && node --test scripts/*.test.mjs",
        "test:watch": "vitest",
        "knip": "knip"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/mdast": "^4.0.4",
        "@types/node": "^25.9.4",
        "@types/unist": "^3.0.3",
        "@vitest/eslint-plugin": "^1.6.28",
        "esbuild": "^0.28.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.18.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-tsdoc": "^0.5.4",
        "globals": "^17.6.0",
        "knip": "^6.44.2",
        "prettier": "^3.9.10",
        "tar": "^7.5.9",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.72.1",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "diff-match-patch-es": "^2.0.1",
        "mdast-util-from-markdown": "^2.1.0",
        "mdast-util-frontmatter": "^2.0.1",
        "mdast-util-gfm": "^3.1.0",
        "mdast-util-math": "^3.0.0",
        "micromark-extension-frontmatter": "^2.0.0",
        "micromark-extension-gfm": "^3.0.0",
        "micromark-extension-gfm-table": "^2.1.1",
        "micromark-extension-math": "^3.1.0"
    },
    "overrides": {
        "eslint-plugin-tsdoc": {
            "@typescript-eslint/utils": "8.72.1"
        }
    }
}
